# Homebrew download stall detection.
# Loaded via HOMEBREW_CURLRC; Homebrew passes --disable --config <path>,
# which keeps ~/.curlrc disabled while loading this file.
#
# Abort a transfer that stays below 1000 bytes/s for 60 consecutive seconds,
# letting Homebrew's built-in --retry 3 reconnect and resume from the partial.

speed-limit = 1000
speed-time = 60
