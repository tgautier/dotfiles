#!/usr/bin/env bash
# End-to-end fixtures for identity, pushed signatures, and exact-tip CI evidence.

set -euo pipefail

readonly LEAKED_GIT_VARS=(
  GIT_INDEX_FILE
  GIT_DIR
  GIT_WORK_TREE
  GIT_NAMESPACE
  GIT_PREFIX
  GIT_OBJECT_DIRECTORY
  GIT_ALTERNATE_OBJECT_DIRECTORIES
  GIT_COMMON_DIR
)
unset "${LEAKED_GIT_VARS[@]}"
for leaked_git_var in "${LEAKED_GIT_VARS[@]}"; do
  if printenv "$leaked_git_var" >/dev/null 2>&1; then
    printf 'FATAL: inherited %s survived fixture isolation\n' "$leaked_git_var" >&2
    exit 1
  fi
done

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
fixture_root=$(mktemp -d) || exit 1
repo="$fixture_root/repo"
tools="$fixture_root/tools"
home="$fixture_root/home"
log="$fixture_root/invoked"
pass=0
fail=0

cleanup() {
  rm -rf -- "$fixture_root"
}
trap cleanup EXIT

record_pass() {
  printf 'ok    - %s\n' "$1"
  pass=$((pass + 1))
}

record_fail() {
  printf 'FAIL  - %s\n' "$1"
  [[ -z "${2:-}" ]] || printf '        output: %s\n' "$2"
  fail=$((fail + 1))
}

file_mode() {
  stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1"
}

mkdir -p "$repo/.githooks/lib" "$tools" "$home"
cp "$source_root/.githooks/pre-push" "$repo/.githooks/pre-push"
cp "$source_root/.githooks/ci-attest" "$repo/.githooks/ci-attest"
cp "$source_root/.githooks/ci-publish" "$repo/.githooks/ci-publish"
cp "$source_root/.githooks/lib/git-integrity.sh" "$repo/.githooks/lib/git-integrity.sh"
printf '%s\n' 'ci:' >"$repo/Justfile"
printf '%s\n' clean >"$repo/tracked"

cat >"$tools/mise" <<'STUB'
#!/bin/sh
if [ "$1" != x ] || [ "$2" != -- ]; then
  exit 2
fi
shift 2
exec "$@"
STUB
cat >"$tools/just" <<'STUB'
#!/bin/sh
if [ "$1" = --summary ]; then
  printf '%s\n' "${JUST_SUMMARY:-ci}"
  exit 0
fi
printf '%s\n' "$*" >>"$INVOKED_LOG"
if [ "${JUST_FAIL:-0}" -eq 1 ]; then
  exit 1
fi
if [ -n "${JUST_MUTATE:-}" ]; then
  printf '%s\n' changed >"$JUST_MUTATE"
fi
STUB
chmod 0755 "$tools/mise" "$tools/just" "$repo/.githooks/pre-push" "$repo/.githooks/ci-attest" "$repo/.githooks/ci-publish"

git -C "$repo" init -q
repo_physical=$(cd -- "$repo" && pwd -P)
fixture_git_dir=$(git -C "$repo" rev-parse --absolute-git-dir)
git_dir_physical=$(cd -- "$fixture_git_dir" && pwd -P)
case "$git_dir_physical" in
  "$repo_physical"/*) ;;
  *)
    printf 'FATAL: fixture Git directory escaped fixture repository: %s\n' "$git_dir_physical" >&2
    exit 1
    ;;
esac
git -C "$repo" add Justfile tracked .githooks

write_commit() {
  local tree=$1 parent=$2 timestamp=$3 signature=$4 message=$5
  {
    printf 'tree %s\n' "$tree"
    [[ -z "$parent" ]] || printf 'parent %s\n' "$parent"
    printf 'author Thomas Gautier <thomas@gautier.gg> %s +0000\n' "$timestamp"
    printf 'committer Thomas Gautier <thomas@gautier.gg> %s +0000\n' "$timestamp"
    case "$signature" in
      signed) printf '%s\n' 'gpgsig fixture-signature' ;;
      signed-sha256) printf '%s\n' 'gpgsig-sha256 fixture-signature' ;;
      unsigned) ;;
      *) printf 'FATAL: unknown fixture signature mode: %s\n' "$signature" >&2; return 1 ;;
    esac
    printf '\n%s\n' "$message"
  } | git -C "$repo" hash-object -t commit -w --stdin
}

write_merge_commit() {
  local tree=$1 first_parent=$2 second_parent=$3 timestamp=$4 message=$5
  {
    printf 'tree %s\n' "$tree"
    printf 'parent %s\n' "$first_parent"
    printf 'parent %s\n' "$second_parent"
    printf 'author Thomas Gautier <thomas@gautier.gg> %s +0000\n' "$timestamp"
    printf 'committer Thomas Gautier <thomas@gautier.gg> %s +0000\n' "$timestamp"
    printf '%s\n' 'gpgsig fixture-signature'
    printf '\n%s\n' "$message"
  } | git -C "$repo" hash-object -t commit -w --stdin
}

tree=$(git -C "$repo" write-tree) || exit 1
legacy=$(write_commit "$tree" '' 0 unsigned 'legacy pre-baseline tip') || exit 1
baseline=$(write_commit "$tree" "$legacy" 1 unsigned baseline) || exit 1
git -C "$repo" update-ref refs/heads/feature "$baseline"
git -C "$repo" symbolic-ref HEAD refs/heads/feature

# The production cutoff belongs to the real history. Replace only the copied
# fixture constant so the same implementation can exercise a tiny local graph.
awk -v baseline="$baseline" '
  /^readonly GIT_INTEGRITY_SIGNATURE_BASELINE=/ {
    printf "readonly GIT_INTEGRITY_SIGNATURE_BASELINE=\"%s\"\n", baseline
    next
  }
  { print }
' "$repo/.githooks/lib/git-integrity.sh" >"$repo/.githooks/lib/git-integrity.sh.tmp" || exit 1
mv "$repo/.githooks/lib/git-integrity.sh.tmp" "$repo/.githooks/lib/git-integrity.sh"
git -C "$repo" add .githooks/lib/git-integrity.sh
tree=$(git -C "$repo" write-tree) || exit 1
head_sha=$(write_commit "$tree" "$baseline" 2 signed 'signed tip') || exit 1
git -C "$repo" update-ref refs/heads/feature "$head_sha"
git -C "$repo" update-ref refs/heads/main "$baseline"

other_signed=$(write_commit "$tree" "$head_sha" 3 signed 'other signed tip') || exit 1
other_unsigned=$(write_commit "$tree" "$head_sha" 4 unsigned 'unsigned tip') || exit 1
sha256_signed=$(write_commit "$tree" "$head_sha" 5 signed-sha256 'sha256 signed tip') || exit 1
unsigned_side=$(write_commit "$tree" "$baseline" 6 unsigned 'unsigned side ancestry') || exit 1
merge_with_unsigned_side=$(write_merge_commit "$tree" "$head_sha" "$unsigned_side" 7 'signed merge with unsigned side') || exit 1
unrelated_root=$(write_commit "$tree" '' 9 signed 'unrelated signed root') || exit 1
unrelated_tip=$(write_commit "$tree" "$unrelated_root" 10 signed 'unrelated signed tip') || exit 1
zero_sha=$(printf '%040d' 0)
git_dir=$(git -C "$repo" rev-parse --absolute-git-dir) || exit 1
marker="$git_dir/local-ci-attestation"

run_attest() {
  (
    cd "$repo" || exit 1
    HOME="$home" PATH="$tools:/usr/bin:/bin" INVOKED_LOG="$log" \
      JUST_FAIL="${JUST_FAIL:-0}" JUST_MUTATE="${JUST_MUTATE:-}" \
      JUST_SUMMARY="${JUST_SUMMARY:-ci}" bash .githooks/ci-attest
  )
}

run_hook() {
  local input=${PUSH_INPUT:-"refs/heads/feature ${PUSH_SHA:-$head_sha} refs/heads/feature ${REMOTE_SHA:-$zero_sha}"}
  (
    cd "$repo" || exit 1
    HOME="$home" PATH="$tools:/usr/bin:/bin" bash .githooks/pre-push origin <<<"$input"
  )
}

expect_hook_pass() {
  local name=$1 output
  if output=$(run_hook 2>&1) && [[ "$output" == *"attestation accepted for $head_sha"* ]]; then
    record_pass "$name"
  else
    record_fail "$name" "$output"
  fi
}

expect_hook_block() {
  local name=$1 expected=$2 output
  if output=$(run_hook 2>&1); then
    record_fail "$name was accepted" "$output"
  elif [[ "$output" == *"$expected"* ]]; then
    record_pass "$name"
  else
    record_fail "$name diagnostic was missing" "$output"
  fi
}

run_identity() {
  (
    cd "$repo" || exit 1
    export GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-Thomas Gautier}"
    export GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-thomas@gautier.gg}"
    export GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-Thomas Gautier}"
    export GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-thomas@gautier.gg}"
    source .githooks/lib/git-integrity.sh
    git_integrity_check_identity
  )
}

if run_identity >/dev/null 2>&1; then
  record_pass "configured author and committer identity pass"
else
  record_fail "configured author and committer identity pass"
fi
if output=$(GIT_AUTHOR_EMAIL=unexpected@example.invalid run_identity 2>&1); then
  record_fail "unexpected author identity was accepted" "$output"
elif [[ "$output" == *"GIT_AUTHOR_IDENT"* ]]; then
  record_pass "unexpected author identity is rejected"
else
  record_fail "unexpected author identity diagnostic was missing" "$output"
fi

: >"$log"
if output=$(run_attest 2>&1) && [[ "$(sed -n '1p' "$marker")" == "$head_sha" ]] && [[ "$(sed -n '1p' "$log")" == ci ]] && [[ "$(file_mode "$marker")" == 600 ]]; then
  record_pass "complete CI attests the exact clean HEAD"
else
  record_fail "complete CI did not attest the exact clean HEAD" "$output"
fi

expect_hook_pass "new signed branch accepts exact-tip evidence"

REMOTE_SHA="$legacy" expect_hook_pass "existing pre-baseline branch excludes exempt ancestry"

if output=$(
  cd "$repo" || exit 1
  source .githooks/lib/git-integrity.sh
  git_integrity_check_push_signatures "$unrelated_tip" "$unrelated_root" 2>&1
); then
  record_fail "existing unrelated branch was accepted" "$output"
elif [[ "$output" == *"does not descend from signature baseline"* ]]; then
  record_pass "existing unrelated branch must descend from baseline"
else
  record_fail "existing unrelated branch diagnostic was missing" "$output"
fi

if (
  cd "$repo" || exit 1
  source .githooks/lib/git-integrity.sh
  git_integrity_has_signature_header "$sha256_signed"
); then
  record_pass "SHA-256 signature header is accepted"
else
  record_fail "SHA-256 signature header is accepted"
fi

printf '%s\n' "$head_sha" >"$marker"
PUSH_SHA="$sha256_signed" REMOTE_SHA="$head_sha" \
  expect_hook_block "SHA-256 signed tip reaches the exact-tip gate" "is not checked-out HEAD"

rm -f "$marker"
expect_hook_block "missing evidence blocks push" "run 'just ci-attest'"

printf '%s\n' "$other_signed" >"$marker"
expect_hook_block "stale evidence cannot cover a new tip" "not ${head_sha:0:12}"

printf '%s\n' malformed >"$marker"
expect_hook_block "malformed evidence fails closed" "malformed attestation"

printf '%s\n%s\n' "$head_sha" appended >"$marker"
expect_hook_block "appended evidence fails closed" "malformed attestation"

rm -f "$marker"
ln -s "$fixture_root/missing" "$marker"
expect_hook_block "symlinked evidence fails closed" "no trusted attestation"
rm -f "$marker"

printf '%s\n' "$head_sha" >"$marker"
PUSH_SHA="$other_unsigned" REMOTE_SHA="$head_sha" \
  expect_hook_block "unsigned pushed ancestry is rejected" "has no Git signature header"

PUSH_SHA="$merge_with_unsigned_side" REMOTE_SHA="$head_sha" \
  expect_hook_block "unsigned side ancestry is rejected" "has no Git signature header"

printf '%s\n' "$head_sha" >"$marker"
PUSH_SHA="$other_signed" REMOTE_SHA="$head_sha" \
  expect_hook_block "another signed tip cannot reuse HEAD evidence" "is not checked-out HEAD"

printf '%s\n' "$head_sha" >"$marker"
printf '%s\n' dirty >"$repo/untracked"
expect_hook_block "dirty checkout cannot use clean evidence" "checkout is dirty"
rm -f "$repo/untracked"

printf '%s\n' "$head_sha" >"$marker"
PUSH_INPUT="refs/heads/feature $head_sha refs/heads/main $head_sha" \
  expect_hook_block "direct main push is rejected" "direct pushes to main"

printf '%s\n' "$head_sha" >"$marker"
PUSH_INPUT="refs/heads/feature $head_sha refs/heads/one $zero_sha
refs/heads/other $other_signed refs/heads/two $zero_sha" \
  expect_hook_block "multiple branch tips are rejected" "push one branch tip at a time"

printf '%s\n' "$head_sha" >"$marker"
if output=$(
  cd "$repo" || exit 1
  source "$source_root/.githooks/pre-push"
  run_local_gate "$head_sha" 2>&1
); then
  record_fail "hook from another checkout was accepted" "$output"
elif [[ "$output" == *"hook root does not match"* ]]; then
  record_pass "hook wiring mismatch fails closed"
else
  record_fail "hook wiring mismatch diagnostic was missing" "$output"
fi

printf '%s\n' "$head_sha" >"$marker"
: >"$log"
if output=$(JUST_SUMMARY=other run_attest 2>&1); then
  record_fail "missing complete recipe was attested" "$output"
elif [[ "$output" == *"no complete ci recipe"* && ! -s "$log" && ! -e "$marker" ]]; then
  record_pass "missing complete recipe invalidates prior evidence"
else
  record_fail "missing complete recipe state or diagnostic was wrong" "$output"
fi

if output=$(
  cd "$repo" || exit 1
  HOME="$home" PATH="/usr/bin:/bin" bash .githooks/ci-attest 2>&1
); then
  record_fail "missing mise was attested" "$output"
elif [[ "$output" == *"mise not found"* && ! -e "$marker" ]]; then
  record_pass "missing mise fails before CI"
else
  record_fail "missing mise state or diagnostic was wrong" "$output"
fi

bare_repo="$fixture_root/origin.git"
shallow_repo="$fixture_root/shallow"
git clone --bare "$repo" "$bare_repo" >/dev/null 2>&1
git clone --depth 1 --branch feature "file://$bare_repo" "$shallow_repo" >/dev/null 2>&1
shallow_head=$(git -C "$shallow_repo" rev-parse HEAD)
if output=$(
  cd "$shallow_repo" || exit 1
  bash .githooks/pre-push origin \
    <<<"refs/heads/feature $shallow_head refs/heads/feature $zero_sha" 2>&1
); then
  record_fail "shallow history was accepted" "$output"
elif [[ "$output" == *"history is shallow"* ]]; then
  record_pass "shallow history is rejected before ancestry claims"
else
  record_fail "shallow-history diagnostic was missing" "$output"
fi

printf '%s\n' "$head_sha" >"$marker"
printf '%s\n' dirty >"$repo/untracked"
: >"$log"
if output=$(run_attest 2>&1); then
  record_fail "dirty checkout was attested" "$output"
elif [[ "$output" == *"checkout is dirty"* && ! -s "$log" && ! -e "$marker" ]]; then
  record_pass "dirty checkout invalidates prior evidence"
else
  record_fail "dirty checkout state or diagnostic was wrong" "$output"
fi
rm -f "$repo/untracked"

printf '%s\n' "$head_sha" >"$marker"
: >"$log"
if output=$(JUST_FAIL=1 run_attest 2>&1); then
  record_fail "failing CI was attested" "$output"
elif [[ "$output" == *"complete gate failed"* && ! -e "$marker" ]]; then
  record_pass "failing CI invalidates prior evidence"
else
  record_fail "failing CI state or diagnostic was wrong" "$output"
fi

printf '%s\n' "$head_sha" >"$marker"
: >"$log"
if output=$(JUST_MUTATE="$repo/tracked" run_attest 2>&1); then
  record_fail "mutating CI was attested" "$output"
elif [[ "$output" == *"repository state changed"* && ! -e "$marker" ]]; then
  record_pass "state changed during CI invalidates evidence"
else
  record_fail "mutating CI state or diagnostic was wrong" "$output"
fi

printf '%s\n' clean >"$repo/tracked"
bare_repo="$fixture_root/publish-origin.git"
awk -v origin="$bare_repo" '
  /^readonly LOCAL_CI_REPO_SLUG=/ {
    print "readonly LOCAL_CI_REPO_SLUG=\"fixture/repo\""
    next
  }
  /^readonly LOCAL_CI_ORIGIN_URL=/ {
    printf "readonly LOCAL_CI_ORIGIN_URL=\"%s\"\n", origin
    next
  }
  { print }
' "$repo/.githooks/ci-publish" >"$repo/.githooks/ci-publish.tmp" || exit 1
mv "$repo/.githooks/ci-publish.tmp" "$repo/.githooks/ci-publish"
chmod 0755 "$repo/.githooks/ci-publish"
git -C "$repo" add tracked .githooks/ci-publish
publish_tree=$(git -C "$repo" write-tree) || exit 1
publish_head=$(write_commit "$publish_tree" "$head_sha" 8 signed 'publish fixture tip') || exit 1
git -C "$repo" update-ref refs/heads/feature "$publish_head"
printf '%s\n' "$publish_head" >"$marker"

git clone --bare "$repo" "$bare_repo" >/dev/null 2>&1
git -C "$repo" remote add origin "$bare_repo"

# Shape captured from GitHub's combined-status REST documentation on
# 2026-08-14 for GET repos/{owner}/{repo}/commits/{ref}/status.
cat >"$tools/gh" <<'STUB'
#!/bin/sh
case " $* " in
  *" --method POST "*)
    [ "${GH_POST_FAIL:-0}" -eq 0 ] || exit 1
    printf '%s\n' "$*" >>"$INVOKED_LOG"
    printf '%s\n' '{}'
    ;;
  *)
    [ "${GH_GET_FAIL:-0}" -eq 0 ] || exit 1
    printf '{"sha":"%s","statuses":[{"state":"%s","context":"%s","created_at":"2026-08-14T00:00:00Z","updated_at":"2026-08-14T00:00:00Z"}]}\n' \
      "$GH_STATUS_SHA" "${GH_STATUS_STATE:-success}" "${GH_STATUS_CONTEXT:-local/exact-tip}"
    ;;
esac
STUB
chmod 0755 "$tools/gh"
ln -s "$(command -v jq)" "$tools/jq"

run_publish() {
  (
    cd "$repo" || exit 1
    HOME="$home" PATH="$tools:/usr/bin:/bin" INVOKED_LOG="$log" \
      GH_STATUS_SHA="${GH_STATUS_SHA:-$publish_head}" \
      GH_STATUS_STATE="${GH_STATUS_STATE:-success}" \
      GH_STATUS_CONTEXT="${GH_STATUS_CONTEXT:-local/exact-tip}" \
      GH_POST_FAIL="${GH_POST_FAIL:-0}" GH_GET_FAIL="${GH_GET_FAIL:-0}" \
      bash .githooks/ci-publish
  )
}

expect_publish_block() {
  local name=$1 expected=$2 output
  if output=$(run_publish 2>&1); then
    record_fail "$name was accepted" "$output"
  elif [[ "$output" == *"$expected"* ]]; then
    record_pass "$name"
  else
    record_fail "$name diagnostic was missing" "$output"
  fi
}

: >"$log"
if output=$(run_publish 2>&1) && [[ "$output" == *"published local/exact-tip=success for $publish_head"* ]] && \
  [[ "$(sed -n '1p' "$log")" == *"repos/fixture/repo/statuses/$publish_head"* ]]; then
  record_pass "pushed exact-tip evidence is published and read back"
else
  record_fail "pushed exact-tip evidence was not published" "$output"
fi

rm -f "$marker"
expect_publish_block "missing attestation cannot be published" "no trusted attestation"
printf '%s\n' "$publish_head" >"$marker"

printf '%s\n' dirty >"$repo/untracked"
expect_publish_block "dirty checkout cannot publish evidence" "checkout is dirty"
rm -f "$repo/untracked"

git -C "$repo" remote set-url origin https://github.com/example/wrong.git
expect_publish_block "non-SSH or wrong origin is rejected" "origin fetch URL must be exactly"
git -C "$repo" remote set-url origin "$bare_repo"

git -C "$repo" remote set-url origin https://github.com/example/wrong.git
git -C "$repo" remote set-url --add --push origin "$bare_repo"
expect_publish_block "split fetch and push origins are rejected" "origin fetch URL must be exactly"
git -C "$repo" config --unset-all remote.origin.pushurl
git -C "$repo" remote set-url origin "$bare_repo"

mv "$tools/gh" "$tools/gh.off"
expect_publish_block "missing GitHub CLI is rejected before network calls" "gh not found"
mv "$tools/gh.off" "$tools/gh"

git -C "$bare_repo" update-ref refs/heads/feature "$other_signed"
expect_publish_block "unpushed local tip is rejected" "does not equal local HEAD"
git -C "$bare_repo" update-ref refs/heads/feature "$publish_head"

git -C "$bare_repo" update-ref refs/heads/main "$unsigned_side"
expect_publish_block "branch behind unrelated main is rejected" "not up to date with origin/main"
git -C "$bare_repo" update-ref refs/heads/main "$baseline"

GH_POST_FAIL=1 expect_publish_block "failed status publication is rejected" "GitHub rejected"
GH_GET_FAIL=1 expect_publish_block "failed status read-back is rejected" "could not read back"
GH_STATUS_STATE=failure expect_publish_block "non-success status read-back is rejected" "did not match"
GH_STATUS_SHA="$head_sha" expect_publish_block "wrong-SHA status read-back is rejected" "did not match"
GH_STATUS_CONTEXT=other expect_publish_block "wrong-context status read-back is rejected" "missing or malformed"

printf '\nlocal gate tests: %d passed, %d failed\n' "$pass" "$fail"
[[ "$fail" -eq 0 ]]
