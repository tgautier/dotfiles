#!/usr/bin/env bash
set -euo pipefail

cleanup_root=

cleanup() {
    if [[ -n "$cleanup_root" && -d "$cleanup_root" ]]; then
        rm -rf -- "$cleanup_root"
    fi
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "$1 is required for the chezmoi parity guard"
}

check_duplicates() {
    local label=$1
    local path=$2
    local duplicates
    duplicates=$(LC_ALL=C sort "$path" | uniq -d)
    if [[ -n "$duplicates" ]]; then
        printf 'ERROR: duplicate manifest %s:\n%s\n' "$label" "$duplicates" >&2
        exit 1
    fi
}

main() {
    local script_dir repo_root manifest private_bridge private_session tmp header line_no
    local source_col target disposition chezmoi_source mode extra
    local source_state expected_source_state diff_output link_destination
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
    repo_root=${1:-$(cd "$script_dir/.." && pwd -P)}
    manifest=${2:-"$repo_root/docs/chezmoi-targets.tsv"}
    private_bridge="$script_dir/private_chezmoi_bridge.py"

    for command_name in chezmoi jq sort uniq cmp comm mktemp python3 wc tr; do
        require_command "$command_name"
    done
    [[ -f "$private_bridge" ]] || fail "missing private chezmoi bridge"
    [[ -f "$repo_root/.chezmoiroot" ]] || fail "missing $repo_root/.chezmoiroot"
    [[ -f "$manifest" ]] || fail "missing target manifest: $manifest"
    manifest=$(cd "$(dirname "$manifest")" && pwd -P)/$(basename "$manifest")

    tmp=$(mktemp -d)
    cleanup_root=$tmp
    trap cleanup EXIT
    private_session="$tmp/private-session"
    mkdir -p "$tmp/cache" "$tmp/destination" "$tmp/operator-home"
    : > "$tmp/config.toml"
    : > "$tmp/all-sources"
    : > "$tmp/all-targets"
    : > "$tmp/expected-map"

    {
        IFS= read -r header || fail "empty target manifest: $manifest"
        [[ "$header" == $'source\ttarget\tdisposition\tchezmoi_source\tmode' ]] || fail "invalid target manifest header"
        line_no=1
        while IFS=$'\t' read -r source_col target disposition chezmoi_source mode extra; do
            line_no=$((line_no + 1))
            [[ -n "$source_col" && -n "$target" && -n "$disposition" && -n "$chezmoi_source" && -n "$mode" && -z "${extra:-}" ]] || fail "invalid target manifest row at line $line_no"
            case "$source_col" in
                /*|../*|*/../*) fail "unsafe source path at line $line_no: $source_col" ;;
            esac
            case "$target" in
                .*/*|.*) ;;
                *) fail "target must be a relative dotfile path at line $line_no: $target" ;;
            esac
            case "/$target/" in
                *'/../'*|*'/./'*|*'//'*) fail "unsafe target at line $line_no: $target" ;;
            esac
            case "$mode" in
                file|executable|symlink) ;;
                *) fail "invalid mode at line $line_no: $mode" ;;
            esac
            [[ -f "$repo_root/$source_col" ]] || fail "missing source at line $line_no: $source_col"
            if [[ "$mode" == executable ]]; then
                [[ -x "$repo_root/$source_col" ]] || fail "source is not executable at line $line_no: $source_col"
            else
                [[ -x "$repo_root/$source_col" ]] && fail "source is unexpectedly executable at line $line_no: $source_col"
            fi
            printf '%s\n' "$source_col" >> "$tmp/all-sources"
            printf '%s\n' "$target" >> "$tmp/all-targets"
            case "$disposition" in
                shadow)
                    case "$chezmoi_source" in
                        -|/*|../*|*/../*) fail "invalid chezmoi source at line $line_no: $chezmoi_source" ;;
                    esac
                    [[ -f "$repo_root/home/$chezmoi_source" ]] || fail "missing chezmoi source at line $line_no: $chezmoi_source"
                    if [[ "$mode" == symlink ]]; then
                        # The template that renders a symlink target is a real
                        # file; a link here would pull template content from
                        # outside the tracked source state.
                        [[ -L "$repo_root/home/$chezmoi_source" ]] && fail "template chezmoi source must not be a symlink at line $line_no: $chezmoi_source"
                    else
                        # File and executable shadow sources are relative
                        # symlinks into the canonical top-level files; a regular
                        # file here reintroduces the duplicated copy the symlink
                        # model removed, and a link elsewhere ships the wrong
                        # content while every byte comparison still passes.
                        [[ -L "$repo_root/home/$chezmoi_source" ]] || fail "shadow chezmoi source is not a symlink at line $line_no: $chezmoi_source"
                        python3 -c 'import os, sys; sys.exit(0 if os.path.realpath(sys.argv[1]) == os.path.realpath(sys.argv[2]) else 1)' \
                            "$repo_root/home/$chezmoi_source" "$repo_root/$source_col" \
                            || fail "shadow chezmoi source resolves outside its manifest source at line $line_no: $chezmoi_source"
                    fi
                    printf '%s\t%s\n' "$target" "$chezmoi_source" >> "$tmp/expected-map"
                    ;;
                repository-only)
                    [[ "$chezmoi_source" == - ]] || fail "repository-only target has a chezmoi source at line $line_no: $target"
                    ;;
                *) fail "unknown disposition at line $line_no: $disposition" ;;
            esac
        done
    } < "$manifest"

    [[ -s "$tmp/all-targets" ]] || fail "target manifest has no entries"
    [[ -s "$tmp/expected-map" ]] || fail "target manifest has no shadow entries"
    check_duplicates sources "$tmp/all-sources"
    check_duplicates targets "$tmp/all-targets"
    LC_ALL=C sort "$tmp/expected-map" > "$tmp/expected-map.sorted"
    check_duplicates 'shadow target mappings' "$tmp/expected-map.sorted"

    local chezmoi_bin jq_bin
    chezmoi_bin=$(command -v chezmoi)
    jq_bin=$(command -v jq)
    local -a chezmoi_args
    chezmoi_args=(--config "$tmp/config.toml" --cache "$tmp/cache" --persistent-state "$tmp/state.boltdb" --source "$repo_root" --destination "$tmp/destination" --no-tty)
    run_chezmoi() {
        env -u GIT_DIR -u GIT_WORK_TREE HOME="$tmp/operator-home" "$chezmoi_bin" "${chezmoi_args[@]}" "$@"
    }

    source_state=$(run_chezmoi source-path)
    source_state=$(cd "$source_state" && pwd -P)
    expected_source_state=$(cd "$repo_root/home" && pwd -P)
    [[ "$source_state" == "$expected_source_state" ]] || fail ".chezmoiroot was not honored: expected $expected_source_state, got $source_state"

    run_chezmoi managed --include files,symlinks --path-style all --format json \
        | "$jq_bin" -r 'to_entries[] | [.key, .value.sourceRelative] | @tsv' \
        | LC_ALL=C sort > "$tmp/actual-map"
    if ! cmp -s "$tmp/expected-map.sorted" "$tmp/actual-map"; then
        printf 'ERROR: chezmoi target map mismatch\nMissing or misnamed mappings:\n' >&2
        LC_ALL=C comm -23 "$tmp/expected-map.sorted" "$tmp/actual-map" >&2
        printf 'Extra or misnamed mappings:\n' >&2
        LC_ALL=C comm -13 "$tmp/expected-map.sorted" "$tmp/actual-map" >&2
        exit 1
    fi

    python3 -B "$private_bridge" ownership --session-state "$private_session" --public-targets "$manifest"

    run_chezmoi apply
    while IFS=$'\t' read -r source_col target disposition chezmoi_source mode extra; do
        [[ "$source_col" == source || "$disposition" == repository-only ]] && continue
        if [[ "$mode" == symlink ]]; then
            # A symlink row is verified by where it points, never by content: `cmp`
            # follows the link to the very file in the source column, so a byte
            # comparison passes even when the destination is wrong.
            [[ -L "$tmp/destination/$target" ]] || fail "rendered target is not a symlink: $target"
            link_destination=$(readlink "$tmp/destination/$target")
            [[ "$link_destination" == "$repo_root/$source_col" ]] \
                || fail "symlink destination differs for $target: expected $repo_root/$source_col, got $link_destination"
            continue
        fi
        cmp -s "$repo_root/$source_col" "$tmp/destination/$target" || fail "rendered bytes differ for $target"
        if [[ "$mode" == executable ]]; then
            [[ -x "$tmp/destination/$target" ]] || fail "rendered target is not executable: $target"
        else
            [[ "$mode" == file ]] && [[ -x "$tmp/destination/$target" ]] && fail "rendered target is unexpectedly executable: $target"
        fi
    done < "$manifest"

    diff_output=$(run_chezmoi diff)
    [[ -z "$diff_output" ]] || fail "first apply left a non-empty chezmoi diff"
    run_chezmoi apply
    diff_output=$(run_chezmoi diff)
    [[ -z "$diff_output" ]] || fail "second apply left a non-empty chezmoi diff"

    python3 -B "$private_bridge" source --session-state "$private_session"

    local total_count shadow_count
    total_count=$(wc -l < "$tmp/all-targets" | tr -d ' ')
    shadow_count=$(wc -l < "$tmp/expected-map.sorted" | tr -d ' ')
    printf 'chezmoi parity OK (%s targets, %s shadow mappings, idempotent apply)\n' "$total_count" "$shadow_count"
}

main "$@"
