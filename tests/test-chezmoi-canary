#!/usr/bin/env bash
set -euo pipefail

cleanup_root=

cleanup() {
    if [[ -n "$cleanup_root" && -d "$cleanup_root" ]]; then
        rm -rf -- "$cleanup_root"
    fi
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

expect_failure() {
    local label=$1
    local expected=$2
    shift 2
    local output
    if output=$("$@" 2>&1); then
        fail "$label fixture passed unexpectedly"
    fi
    case "$output" in
        *"$expected"*) ;;
        *) printf '%s\n' "$output" >&2; fail "$label fixture failed for the wrong reason" ;;
    esac
}

expect_failure_withheld() {
    local label=$1
    local expected=$2
    local forbidden=$3
    shift 3
    local output
    if output=$("$@" 2>&1); then
        fail "$label fixture passed unexpectedly"
    fi
    case "$output" in
        *"$expected"*) ;;
        *) printf '%s\n' "$output" >&2; fail "$label fixture failed for the wrong reason" ;;
    esac
    case "$output" in
        *"$forbidden"*) printf '%s\n' "$output" >&2; fail "$label fixture exposed companion output" ;;
    esac
}

make_fixture() {
    local destination=$1
    local source_col
    mkdir -p "$destination/docs"
    cp -p "$repo_root/.chezmoiroot" "$destination/.chezmoiroot"
    cp -R "$repo_root/home" "$destination/home"
    cp -p "$manifest" "$destination/docs/chezmoi-targets.tsv"
    while IFS=$'\t' read -r source_col _; do
        [[ "$source_col" == source ]] && continue
        mkdir -p "$destination/$(dirname "$source_col")"
        cp -p "$repo_root/$source_col" "$destination/$source_col"
    done < "$manifest"
}

main() {
    local script_dir repo_root manifest checker tmp output probe_output venv_site
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
    repo_root=$(cd "$script_dir/.." && pwd -P)
    manifest="$repo_root/docs/chezmoi-targets.tsv"
    checker="$script_dir/check-chezmoi-targets"
    [[ -x "$checker" ]] || fail "missing executable parity checker: $checker"

    "$checker" "$repo_root" "$manifest"

    tmp=$(mktemp -d)
    tmp=$(cd "$tmp" && pwd -P)
    cleanup_root=$tmp
    trap cleanup EXIT

    if ! output=$(cd "$repo_root" && DOTFILES_PRIVATE_DIR="$tmp/absent-private" "$checker" "$repo_root" docs/chezmoi-targets.tsv 2>&1); then
        printf '%s\n' "$output" >&2
        fail "absent private checkout did not preserve the public-only canary"
    fi
    case "$output" in
        *'companion chezmoi ownership: skipped'*'companion chezmoi source: skipped'*) ;;
        *) printf '%s\n' "$output" >&2; fail "absent private checkout did not report the public-only skip" ;;
    esac

    : > "$tmp/non-directory-private"
    expect_failure 'non-directory private path' 'companion checkout path is not a directory' \
        env DOTFILES_PRIVATE_DIR="$tmp/non-directory-private" "$checker" "$repo_root" "$manifest"

    mkdir -p "$tmp/accepting-private/shared/chezmoi"
    : > "$tmp/accepting-private/shared/chezmoi/__init__.py"
    cat > "$tmp/accepting-private/shared/chezmoi/check_target_ownership.py" <<'PY'
from pathlib import Path
import sys

if len(sys.argv) != 3 or sys.argv[1] != "--public-targets" or not Path(sys.argv[2]).is_file():
    print("fixture checker received the wrong public manifest contract", file=sys.stderr)
    raise SystemExit(24)
print("fixture ownership accepted")
PY
    cat > "$tmp/accepting-private/shared/chezmoi/check_private_source.py" <<'PY'
print("fixture private source accepted")
PY
    mkdir -p "$tmp/conflicting-pythonpath/shared/chezmoi"
    : > "$tmp/conflicting-pythonpath/shared/__init__.py"
    : > "$tmp/conflicting-pythonpath/shared/chezmoi/__init__.py"
    cat > "$tmp/conflicting-pythonpath/shared/chezmoi/check_target_ownership.py" <<'PY'
print("conflicting shared package ran")
PY
    if ! probe_output=$(cd "$tmp/accepting-private" && PYTHONPATH="$tmp/conflicting-pythonpath" python3 -S -B -m shared.chezmoi.check_target_ownership 2>&1); then
        printf '%s\n' "$probe_output" >&2
        fail "conflicting Python path fixture could not reach its shadow package"
    fi
    case "$probe_output" in
        *'conflicting shared package ran'*) ;;
        *) printf '%s\n' "$probe_output" >&2; fail "conflicting Python path fixture was not load-bearing" ;;
    esac
    if ! python3 -m venv "$tmp/conflicting-venv"; then
        fail "could not create the conflicting site-package fixture"
    fi
    if ! venv_site=$("$tmp/conflicting-venv/bin/python3" -c 'import sysconfig; print(sysconfig.get_path("purelib"))' 2>&1); then
        printf '%s\n' "$venv_site" >&2
        fail "could not resolve the conflicting virtual environment's site-packages"
    fi
    case "$venv_site" in
        "$tmp/conflicting-venv"/*) ;;
        *) fail "conflicting virtual environment resolved site-packages outside its fixture: $venv_site" ;;
    esac
    mkdir -p "$venv_site/shared/chezmoi"
    : > "$venv_site/shared/__init__.py"
    : > "$venv_site/shared/chezmoi/__init__.py"
    cat > "$venv_site/shared/chezmoi/check_target_ownership.py" <<'PY'
print("conflicting site package ran")
PY
    if ! probe_output=$(cd "$tmp/accepting-private" && "$tmp/conflicting-venv/bin/python3" -E -B -m shared.chezmoi.check_target_ownership 2>&1); then
        printf '%s\n' "$probe_output" >&2
        fail "conflicting site-package fixture could not reach its shadow package"
    fi
    case "$probe_output" in
        *'conflicting site package ran'*) ;;
        *) printf '%s\n' "$probe_output" >&2; fail "conflicting site-package fixture was not load-bearing" ;;
    esac
    if ! output=$(cd "$repo_root" && PATH="$tmp/conflicting-venv/bin:$PATH" PYTHONPATH="$tmp/conflicting-pythonpath" DOTFILES_PRIVATE_DIR="$tmp/accepting-private" "$checker" "$repo_root" docs/chezmoi-targets.tsv 2>&1); then
        printf '%s\n' "$output" >&2
        fail "accepting private checker did not preserve the canary"
    fi
    case "$output" in
        *'companion chezmoi ownership: passed'*'companion chezmoi source: passed'*'chezmoi parity OK'*) ;;
        *) printf '%s\n' "$output" >&2; fail "accepting private checker did not run through the canary" ;;
    esac
    case "$output" in
        *'fixture ownership accepted'*) printf '%s\n' "$output" >&2; fail "ownership checker output was exposed" ;;
        *'fixture private source accepted'*) printf '%s\n' "$output" >&2; fail "source checker output was exposed" ;;
        *'conflicting shared package ran'*) printf '%s\n' "$output" >&2; fail "Python path shadowed the selected private checker" ;;
        *'conflicting site package ran'*) printf '%s\n' "$output" >&2; fail "Python site-packages shadowed the selected private checker" ;;
    esac
    [[ ! -e "$tmp/accepting-private/shared/chezmoi/__pycache__" ]] || fail "accepting private checker wrote bytecode into the selected checkout"

    mkdir -p "$tmp/stale-private"
    expect_failure 'stale private checkout' 'companion checkout is incompatible' \
        env DOTFILES_PRIVATE_DIR="$tmp/stale-private" "$checker" "$repo_root" "$manifest"

    mkdir -p "$tmp/rejecting-private/shared/chezmoi"
    : > "$tmp/rejecting-private/shared/chezmoi/__init__.py"
    cat > "$tmp/rejecting-private/shared/chezmoi/check_target_ownership.py" <<'PY'
from pathlib import Path
import sys

if len(sys.argv) != 3 or sys.argv[1] != "--public-targets" or not Path(sys.argv[2]).is_file():
    print("fixture checker received the wrong public manifest contract", file=sys.stderr)
    raise SystemExit(24)
print("fixture overlap detected", file=sys.stderr)
raise SystemExit(23)
PY
    pushd "$repo_root" >/dev/null
    expect_failure_withheld 'rejected ownership' 'companion check failed with status 23; output withheld' 'fixture overlap detected' \
        env DOTFILES_PRIVATE_DIR="$tmp/rejecting-private" "$checker" "$repo_root" docs/chezmoi-targets.tsv
    popd >/dev/null

    mkdir -p "$tmp/rejecting-source/shared/chezmoi"
    : > "$tmp/rejecting-source/shared/chezmoi/__init__.py"
    cp "$tmp/accepting-private/shared/chezmoi/check_target_ownership.py" \
        "$tmp/rejecting-source/shared/chezmoi/check_target_ownership.py"
    cat > "$tmp/rejecting-source/shared/chezmoi/check_private_source.py" <<'PY'
import sys

print("fixture private source rejected", file=sys.stderr)
raise SystemExit(29)
PY
    expect_failure_withheld 'rejected private source' 'companion check failed with status 29; output withheld' 'fixture private source rejected' \
        env DOTFILES_PRIVATE_DIR="$tmp/rejecting-source" "$checker" "$repo_root" "$manifest"

    awk 'BEGIN { FS=OFS="\t" } $2 == ".zsh/zaliases" { $2=".zsh/.zaliases" } { print }' "$manifest" > "$tmp/misnamed.tsv"
    expect_failure misnamed 'target map mismatch' "$checker" "$repo_root" "$tmp/misnamed.tsv"

    awk 'BEGIN { FS=OFS="\t" } $2 != ".zsh/zaliases" { print }' "$manifest" > "$tmp/shadow-omitted.tsv"
    expect_failure 'shadow omission' 'target map mismatch' "$checker" "$repo_root" "$tmp/shadow-omitted.tsv"

    awk 'BEGIN { FS=OFS="\t" } $2 != ".Brewfile" { print }' "$manifest" > "$tmp/deferred-omitted.tsv"
    expect_failure 'deferred omission' 'target map mismatch' "$checker" "$repo_root" "$tmp/deferred-omitted.tsv"

    awk 'BEGIN { FS=OFS="\t" } $2 == ".Brewfile" { $3="drop-empty-placeholder" } { print }' "$manifest" > "$tmp/retired-disposition.tsv"
    expect_failure 'retired disposition' 'unknown disposition' "$checker" "$repo_root" "$tmp/retired-disposition.tsv"

    awk 'NR == 2 { print } { print }' "$manifest" > "$tmp/duplicate.tsv"
    expect_failure duplicate 'duplicate manifest' "$checker" "$repo_root" "$tmp/duplicate.tsv"

    make_fixture "$tmp/missing"
    rm "$tmp/missing/home/dot_zsh/zaliases"
    expect_failure missing 'missing chezmoi source' "$checker" "$tmp/missing" "$tmp/missing/docs/chezmoi-targets.tsv"

    # A symlink row is verified by its DESTINATION, never by content. `cmp`
    # follows the link to the very file named in the source column, so a byte
    # comparison passes even when the link points somewhere else entirely.
    # Repoint the template at a sibling and require the checker to notice.
    make_fixture "$tmp/wrong-symlink"
    printf '%s\n' '{{ .chezmoi.workingTree }}/config/mise/decoy.toml' \
        > "$tmp/wrong-symlink/home/dot_config/mise/symlink_config.toml.tmpl"
    cp -p "$repo_root/config/mise/config.toml" "$tmp/wrong-symlink/config/mise/decoy.toml"
    expect_failure 'wrong symlink destination' 'symlink destination differs' \
        "$checker" "$tmp/wrong-symlink" "$tmp/wrong-symlink/docs/chezmoi-targets.tsv"

    make_fixture "$tmp/extra"
    printf 'unexpected fixture\n' > "$tmp/extra/home/dot_unexpected"
    expect_failure extra 'target map mismatch' "$checker" "$tmp/extra" "$tmp/extra/docs/chezmoi-targets.tsv"

    # Shadow sources are relative symlinks into the canonical top-level files.
    # A regular file reintroduces the duplicated copy the symlink model
    # removed, and it would pass every byte comparison as long as the copy is
    # fresh — so the checker must reject the shape, not the content.
    make_fixture "$tmp/copied-shadow"
    rm "$tmp/copied-shadow/home/dot_zshrc"
    cp -p "$repo_root/zshrc" "$tmp/copied-shadow/home/dot_zshrc"
    expect_failure 'reintroduced shadow copy' 'shadow chezmoi source is not a symlink' \
        "$checker" "$tmp/copied-shadow" "$tmp/copied-shadow/docs/chezmoi-targets.tsv"

    # A link at the right path but the wrong destination ships the wrong
    # content while staying a symlink; the resolution check must catch it.
    make_fixture "$tmp/mispointed-shadow"
    ln -sfn ../zshenv "$tmp/mispointed-shadow/home/dot_zshrc"
    expect_failure 'mispointed shadow symlink' 'resolves outside its manifest source' \
        "$checker" "$tmp/mispointed-shadow" "$tmp/mispointed-shadow/docs/chezmoi-targets.tsv"

    # The template row is the inverse contract: it must stay a real file, so a
    # symlink smuggling template content from outside the source state fails.
    make_fixture "$tmp/linked-template"
    ln -sfn ../../../config/mise/config.toml \
        "$tmp/linked-template/home/dot_config/mise/symlink_config.toml.tmpl"
    expect_failure 'linked template source' 'template chezmoi source must not be a symlink' \
        "$checker" "$tmp/linked-template" "$tmp/linked-template/docs/chezmoi-targets.tsv"

    printf 'chezmoi canary fixtures OK (companion available/conflicting-package/absent/non-directory/stale/ownership-rejected/source-rejected, misnamed, shadow/deferred omission, retired disposition, duplicate, missing, extra, wrong symlink destination, reintroduced shadow copy, mispointed shadow symlink, linked template source)\n'
}

main "$@"
