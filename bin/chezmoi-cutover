#!/usr/bin/env python3
"""Inspect and deploy the public and optional private dotfile sources."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
from dataclasses import dataclass
import fcntl
import os
from pathlib import Path
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from typing import Callable, Iterator, Sequence


MAX_COMMAND_OUTPUT_BYTES = 16 * 1024 * 1024
MAX_SOURCE_BYTES = 64 * 1024 * 1024
CHEZMOI_TIMEOUT_SECONDS = 120
CANARY_TIMEOUT_SECONDS = 180
DEDICATED_OWNER_TIMEOUT_SECONDS = 180
PROCESS_GROUP_CLEANUP_SECONDS = 2
PROCESS_GROUP_TERM_GRACE_SECONDS = 0.1


class CutoverError(RuntimeError):
    """The operator command cannot establish a safe chezmoi invocation."""


class TerminationRequested(BaseException):
    """A recoverable termination signal interrupted the operator command."""

    def __init__(self, signum: int) -> None:
        self.signum = signum
        super().__init__(signal.Signals(signum).name)


@dataclass
class TerminationState:
    """Track the first termination request and defer repeats during recovery."""

    signum: int | None = None
    recovering: bool = False
    committed: bool = False


HANDLED_TERMINATION_SIGNALS = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)


@dataclass(frozen=True)
class SourceState:
    """One independently configured chezmoi source repository."""

    label: str
    root: Path
    config: Path


@contextmanager
def recoverable_termination_signals(
    *, retain_committed_handlers: bool = False
) -> Iterator[TerminationState]:
    """Convert termination signals and restore handlers unless success retains them."""

    state = TerminationState()
    previous: dict[int, signal.Handlers] = {}

    def request_termination(signum: int, _frame: object) -> None:
        if state.signum is None:
            state.signum = signum
            if not state.recovering and not state.committed:
                raise TerminationRequested(signum)

    try:
        for signum in HANDLED_TERMINATION_SIGNALS:
            previous[signum] = signal.getsignal(signum)
            signal.signal(signum, request_termination)
        yield state
    finally:
        if not (state.committed and retain_committed_handlers):
            try:
                previous_mask = signal.pthread_sigmask(
                    signal.SIG_BLOCK,
                    set(HANDLED_TERMINATION_SIGNALS),
                )
                try:
                    for signum, handler in previous.items():
                        signal.signal(signum, handler)
                finally:
                    signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
            except (AttributeError, OSError) as exc:
                raise CutoverError(
                    f"cannot restore the termination signal handlers: {exc}"
                ) from exc


def mark_operation_committed(state: TerminationState) -> None:
    """Atomically commit success before termination handlers are removed."""

    try:
        previous_mask = signal.pthread_sigmask(
            signal.SIG_BLOCK,
            set(HANDLED_TERMINATION_SIGNALS),
        )
        state.committed = True
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
    except (AttributeError, OSError) as exc:
        raise CutoverError(f"cannot commit the completion signal handoff: {exc}") from exc


def lexical_absolute(path: Path) -> Path:
    """Return an absolute normalized path without resolving symlinks."""

    return Path(os.path.abspath(os.path.normpath(path)))


def require_directory(path: Path, *, label: str) -> Path:
    """Require a real directory and return its canonical location."""

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise CutoverError(f"cannot inspect {label}: {exc}") from exc
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise CutoverError(f"{label} must be a non-symlink directory")
    try:
        return path.resolve(strict=True)
    except OSError as exc:
        raise CutoverError(f"cannot resolve {label}: {exc}") from exc


def optional_directory(path: Path, *, label: str) -> Path | None:
    """Resolve an optional directory while distinguishing invalid paths."""

    try:
        path.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise CutoverError(f"cannot inspect {label}: {exc}") from exc
    return require_directory(path, label=label)


def require_regular_file(path: Path, *, label: str) -> Path:
    """Require a non-symlink regular file."""

    try:
        metadata = path.lstat()
    except OSError as exc:
        raise CutoverError(f"cannot inspect {label}: {exc}") from exc
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise CutoverError(f"{label} must be a non-symlink regular file")
    return path


def require_source(root: Path, *, label: str, config: Path) -> SourceState:
    """Validate the repository layout needed by a live invocation."""

    root = require_directory(root, label=f"{label} repository")
    root_marker = require_regular_file(root / ".chezmoiroot", label=f"{label} .chezmoiroot")
    try:
        marker = root_marker.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise CutoverError(f"cannot read {label} .chezmoiroot: {exc}") from exc
    if marker != "home\n":
        raise CutoverError(f"{label} .chezmoiroot must contain exactly 'home'")
    require_directory(root / "home", label=f"{label} source state")
    config = require_regular_file(root / config, label=f"{label} config")
    return SourceState(label, root, config)


def source_states(public: Path, private: Path) -> tuple[SourceState, ...]:
    """Load the required public source and optional private companion."""

    public_state = require_source(
        public,
        label="public",
        config=Path("chezmoi.toml"),
    )
    private_root = optional_directory(private, label="private repository")
    if private_root is None:
        return (public_state,)
    private_state = require_source(
        private_root,
        label="private",
        config=Path("chezmoi-private.toml"),
    )
    if public_state.root == private_state.root:
        raise CutoverError("public and private repositories resolve to the same directory")
    return (public_state, private_state)


def runtime_root(
    explicit: Path | None,
    *,
    environment_name: str,
    fallback: Path,
    label: str,
) -> Path:
    """Select an absolute operator-state root."""

    selected = explicit
    if selected is None:
        configured = os.environ.get(environment_name)
        selected = Path(configured) / "dotfiles/chezmoi" if configured else fallback
    if not selected.is_absolute():
        raise CutoverError(f"{label} must be an absolute path")
    return lexical_absolute(selected)


def ensure_private_directory(path: Path, *, label: str) -> Path:
    """Create an owner-only runtime directory or reject an unsafe existing path."""

    try:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        metadata = path.lstat()
    except OSError as exc:
        raise CutoverError(f"cannot prepare {label}: {exc}") from exc
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
        raise CutoverError(f"{label} must be a non-symlink directory")
    if metadata.st_uid != os.getuid():
        raise CutoverError(f"{label} must be owned by the current user")
    mode = stat.S_IMODE(metadata.st_mode)
    if mode & 0o077:
        raise CutoverError(f"{label} must not be accessible by group or other users")
    return path


@contextmanager
def operator_lock(state_root: Path) -> Iterator[None]:
    """Serialize every command that shares the persistent chezmoi state."""

    lock_path = state_root / "operator.lock"
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except OSError as exc:
        raise CutoverError(f"cannot open chezmoi operator lock: {exc}") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise CutoverError("chezmoi operator lock is not a current-user regular file")
        if stat.S_IMODE(metadata.st_mode) & 0o077:
            raise CutoverError("chezmoi operator lock is accessible by another user")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CutoverError("another chezmoi operator command is already running") from exc
        except OSError as exc:
            raise CutoverError(f"cannot lock chezmoi operator state: {exc}") from exc
        yield
    finally:
        os.close(descriptor)


def resolve_executable(value: str, *, label: str) -> Path:
    """Resolve one selected executable once before any source runs."""

    candidate = shutil.which(value)
    if candidate is None:
        raise CutoverError(f"{label} is not installed or is not executable")
    try:
        path = Path(candidate).resolve(strict=True)
    except OSError as exc:
        raise CutoverError(f"cannot resolve {label} executable: {exc}") from exc
    if not path.is_file() or not os.access(path, os.X_OK):
        raise CutoverError(f"{label} is not a regular executable file")
    return path


def command_arguments(
    executable: Path,
    source: SourceState,
    *,
    home: Path,
    cache_root: Path,
    state_root: Path,
    operation: str,
) -> list[str]:
    """Build an explicit invocation independent of user chezmoi defaults."""

    arguments = [
        str(executable),
        "--source",
        str(source.root),
        "--destination",
        str(home),
        "--cache",
        str(cache_root / source.label),
        "--persistent-state",
        str(state_root / f"{source.label}.boltdb"),
        "--no-tty",
        "--no-pager",
        "--color=false",
        "--progress=false",
        "--refresh-externals=never",
    ]
    arguments.extend(("--config", str(source.config)))
    if operation == "status":
        arguments.extend(("status", "--include", "files,dirs,symlinks", "--path-style=relative"))
    elif operation == "diff":
        arguments.extend(("diff", "--include", "files,dirs,symlinks", "--recursive"))
    elif operation == "dry-run":
        arguments.extend(("apply", "--include", "files,dirs,symlinks", "--dry-run", "--verbose"))
    elif operation == "apply":
        arguments.extend(("apply", "--include", "files,dirs,symlinks", "--force"))
    elif operation == "safe-apply":
        arguments.extend(("apply", "--include", "files,dirs,symlinks", "--error-on-conflict"))
    else:
        raise CutoverError(f"unsupported operator command: {operation}")
    return arguments


def command_environment(home: Path) -> dict[str, str]:
    """Remove repository and chezmoi overrides while preserving user context."""

    removed_names = {
        "DOTFILES_DIR",
        "DOTFILES_PRIVATE_DIR",
        "PYTHONHOME",
        "PYTHONPATH",
        "PYTHONSTARTUP",
        "PYTHONWARNINGS",
        "VIRTUAL_ENV",
        "__PYVENV_LAUNCHER__",
    }
    environment = {
        name: value
        for name, value in os.environ.items()
        if (
            name not in removed_names
            and not name.startswith("GIT_")
            and not name.startswith("CHEZMOI_")
            and not name.startswith("RCM_")
        )
    }
    environment["HOME"] = str(home)
    environment["NO_COLOR"] = "1"
    environment["TERM"] = "dumb"
    return environment


def wait_without_reaping(process: subprocess.Popen[bytes], timeout: int | float) -> bool:
    """Wait for a child while retaining its process-group identity."""

    deadline = time.monotonic() + timeout
    while True:
        result = os.waitid(
            os.P_PID,
            process.pid,
            os.WEXITED | os.WNOHANG | os.WNOWAIT,
        )
        if result is not None:
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        time.sleep(min(0.01, remaining))


def terminate_process_group(process: subprocess.Popen[bytes], *, label: str) -> None:
    """Terminate a child process group, escalate if needed, and reap its leader."""

    try:
        os.killpg(process.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        try:
            process.wait(timeout=PROCESS_GROUP_CLEANUP_SECONDS)
        except subprocess.TimeoutExpired as exc:
            raise CutoverError(f"cannot reap {label} process") from exc
        return

    time.sleep(PROCESS_GROUP_TERM_GRACE_SECONDS)
    try:
        # The unreaped leader pins the numeric process-group identity against
        # PID reuse until every descendant has received the final signal.
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass

    try:
        process.wait(timeout=PROCESS_GROUP_CLEANUP_SECONDS)
    except subprocess.TimeoutExpired as exc:
        raise CutoverError(f"cannot reap {label} process") from exc


def run_bounded_process(
    arguments: Sequence[str],
    *,
    cwd: Path,
    environment: dict[str, str],
    stdin: object,
    stdout: object,
    stderr: object,
    timeout: int | float,
    label: str,
) -> int:
    """Run one command in a private process group with bounded cleanup."""

    try:
        process = subprocess.Popen(
            arguments,
            cwd=cwd,
            env=environment,
            stdin=stdin,
            stdout=stdout,
            stderr=stderr,
            start_new_session=True,
        )
    except OSError as exc:
        raise CutoverError(f"cannot run {label}: {exc}") from exc

    completed = False
    try:
        completed = wait_without_reaping(process, timeout)
    except BaseException:
        terminate_process_group(process, label=label)
        raise

    terminate_process_group(process, label=label)
    if not completed:
        raise CutoverError(f"{label} exceeded {timeout} seconds")
    if process.returncode is None:
        raise CutoverError(f"cannot determine {label} status")
    return process.returncode


def capture_bounded_process(
    arguments: Sequence[str],
    *,
    cwd: Path,
    environment: dict[str, str],
    stderr: object,
    timeout: int | float,
    label: str,
) -> tuple[int, bytes]:
    """Capture bounded output while supervising a private process group."""

    try:
        process = subprocess.Popen(
            arguments,
            cwd=cwd,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=stderr,
            start_new_session=True,
        )
    except OSError as exc:
        raise CutoverError(f"cannot run {label}: {exc}") from exc
    if process.stdout is None:
        terminate_process_group(process, label=label)
        raise CutoverError(f"cannot capture {label} output")

    captured = bytearray()
    deadline = time.monotonic() + timeout
    cleaned = False
    descriptor = process.stdout.fileno()
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(descriptor, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    terminate_process_group(process, label=label)
                    cleaned = True
                    raise CutoverError(f"{label} exceeded {timeout} seconds")
                for _key, _events in selector.select(min(0.05, remaining)):
                    chunk = os.read(
                        descriptor,
                        min(64 * 1024, MAX_COMMAND_OUTPUT_BYTES + 1 - len(captured)),
                    )
                    captured.extend(chunk)
                    if len(captured) > MAX_COMMAND_OUTPUT_BYTES:
                        terminate_process_group(process, label=label)
                        cleaned = True
                        raise CutoverError(f"{label} output exceeds the safety limit")
                    if not chunk:
                        selector.unregister(descriptor)
                if wait_without_reaping(process, 0):
                    terminate_process_group(process, label=label)
                    cleaned = True
                    os.set_blocking(descriptor, True)
                    while chunk := os.read(
                        descriptor,
                        min(64 * 1024, MAX_COMMAND_OUTPUT_BYTES + 1 - len(captured)),
                    ):
                        captured.extend(chunk)
                        if len(captured) > MAX_COMMAND_OUTPUT_BYTES:
                            raise CutoverError(f"{label} output exceeds the safety limit")
                    break
    except OSError as exc:
        if not cleaned:
            terminate_process_group(process, label=label)
        raise CutoverError(f"cannot monitor {label}: {exc}") from exc
    except BaseException:
        if not cleaned:
            terminate_process_group(process, label=label)
        raise
    finally:
        process.stdout.close()

    if process.returncode is None:
        raise CutoverError(f"cannot determine {label} status")
    return process.returncode, bytes(captured)


def capture_operation(
    operation: str,
    *,
    executable: Path,
    source: SourceState,
    home: Path,
    cache_root: Path,
    state_root: Path,
    show_output: bool,
) -> bytes:
    """Run one bounded command while keeping its output in an unnamed file."""

    environment = command_environment(home)
    print(f"==> {source.label} chezmoi {operation}", file=sys.stderr)
    returncode, captured = capture_bounded_process(
        command_arguments(
            executable,
            source,
            home=home,
            cache_root=cache_root,
            state_root=state_root,
            operation=operation,
        ),
        cwd=source.root,
        environment=environment,
        stderr=subprocess.STDOUT,
        timeout=CHEZMOI_TIMEOUT_SECONDS,
        label=f"{source.label} chezmoi {operation}",
    )
    if show_output and captured:
        sys.stdout.buffer.write(captured)
        sys.stdout.buffer.flush()
    if returncode != 0:
        raise CutoverError(
            f"{source.label} chezmoi {operation} failed with status {returncode}"
        )
    return captured


def run_operation(
    operation: str,
    *,
    executable: Path,
    sources: Sequence[SourceState],
    home: Path,
    cache_root: Path,
    state_root: Path,
) -> None:
    """Run the same inspection against each source in deterministic order."""

    for source in sources:
        capture_operation(
            operation,
            executable=executable,
            source=source,
            home=home,
            cache_root=cache_root,
            state_root=state_root,
            show_output=True,
        )



def path_argument(value: str) -> Path:
    """Reject an empty CLI path before it can resolve to the current directory."""

    if not value:
        raise argparse.ArgumentTypeError("path must not be empty")
    return Path(value)



def run_dedicated_private_owners(
    *,
    private: Path,
    public: Path,
    home: Path,
    just: Path,
) -> None:
    """Run the private aggregate without exposing companion command output."""

    justfile = require_regular_file(private / "justfile", label="private justfile")
    environment = command_environment(home)
    environment["DOTFILES_DIR"] = str(public)
    environment["DOTFILES_PRIVATE_DIR"] = str(private)
    returncode = run_bounded_process(
        [
            str(just),
            "--no-dotenv",
            "--justfile",
            str(justfile),
            "--working-directory",
            str(private),
            "dedicated-targets-install",
        ],
        cwd=private,
        environment=environment,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=DEDICATED_OWNER_TIMEOUT_SECONDS,
        label="private dedicated target installers",
    )
    if returncode != 0:
        raise CutoverError(
            f"private dedicated target installers failed with status {returncode}; output withheld"
        )
    print("==> private dedicated targets verified", file=sys.stderr)



def run_parity_check(
    *,
    checker: Path,
    executable: Path,
    public: Path,
    private: Path,
    home: Path,
) -> None:
    """Validate the current public and optional private ownership contracts."""

    checker = require_regular_file(checker, label="chezmoi parity checker")
    environment = command_environment(home)
    environment["DOTFILES_DIR"] = str(public)
    environment["DOTFILES_PRIVATE_DIR"] = str(private)
    print("==> isolated public/private chezmoi parity check", file=sys.stderr)
    try:
        with tempfile.TemporaryDirectory(prefix="chezmoi-link-tools-") as temporary:
            tool_directory = Path(temporary)
            (tool_directory / "chezmoi").symlink_to(executable)
            environment["PATH"] = (
                f"{tool_directory}{os.pathsep}{environment.get('PATH', '')}"
            )
            returncode = run_bounded_process(
                [str(checker), str(public), str(public / "docs/chezmoi-targets.tsv")],
                cwd=public,
                environment=environment,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=CANARY_TIMEOUT_SECONDS,
                label="chezmoi parity check",
            )
    except OSError as exc:
        raise CutoverError(f"cannot prepare exact parity-check executables: {exc}") from exc
    if returncode != 0:
        raise CutoverError(
            f"chezmoi parity check failed with status {returncode}; output withheld"
        )


def link_current_state(
    *,
    executable: Path,
    sources: Sequence[SourceState],
    public: Path,
    private: Path,
    home: Path,
    cache_root: Path,
    state_root: Path,
    just: Path,
    parity_check: Path,
    termination: TerminationState,
) -> None:
    """Refresh each target through its current owner and prove idempotence."""

    run_parity_check(
        checker=parity_check,
        executable=executable,
        public=public,
        private=private,
        home=home,
    )
    if len(sources) == 2:
        run_dedicated_private_owners(
            private=private,
            public=public,
            home=home,
            just=just,
        )
    for pass_number in (1, 2):
        for source in sources:
            capture_operation(
                "safe-apply",
                executable=executable,
                source=source,
                home=home,
                cache_root=cache_root,
                state_root=state_root,
                show_output=False,
            )
        require_settled_state(
            executable=executable,
            sources=sources,
            home=home,
            cache_root=cache_root,
            state_root=state_root,
            label=f"link pass {pass_number}",
            before_operation=lambda: None,
        )
    mark_operation_committed(termination)
    print("dotfile ownership refresh complete: all owners are idempotent", file=sys.stderr)



def require_settled_state(
    *,
    executable: Path,
    sources: Sequence[SourceState],
    home: Path,
    cache_root: Path,
    state_root: Path,
    label: str,
    before_operation: Callable[[], None],
) -> None:
    """Require status, diff, and dry-run to agree that no change remains."""

    for source in sources:
        for operation in ("status", "diff", "dry-run"):
            before_operation()
            output = capture_operation(
                operation,
                executable=executable,
                source=source,
                home=home,
                cache_root=cache_root,
                state_root=state_root,
                show_output=False,
            )
            if output:
                raise CutoverError(
                    f"{label}: {source.label} chezmoi {operation} is not empty"
                )



def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    """Parse one operator inspection command."""

    repository = Path(__file__).resolve().parent.parent
    home_default = Path.home()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "operation",
        choices=("status", "diff", "dry-run", "link"),
    )
    parser.add_argument(
        "--home",
        type=path_argument,
        default=home_default,
    )
    parser.add_argument(
        "--public-dir",
        type=path_argument,
        default=Path(os.environ.get("DOTFILES_DIR", repository)),
    )
    parser.add_argument(
        "--private-dir",
        type=path_argument,
        default=Path(
            os.environ.get(
                "DOTFILES_PRIVATE_DIR",
                home_default / "Workspace/tgautier/dotfiles-private",
            )
        ),
    )
    parser.add_argument("--cache-dir", type=path_argument)
    parser.add_argument("--state-dir", type=path_argument)
    parser.add_argument("--chezmoi", default="chezmoi")
    parser.add_argument("--just", default="just")
    parser.add_argument("--parity-check", type=path_argument)
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    """Run the selected inspection and translate expected failures."""

    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        home = require_directory(lexical_absolute(args.home), label="HOME")
        sources = source_states(
            lexical_absolute(args.public_dir),
            lexical_absolute(args.private_dir),
        )
        state_root = ensure_private_directory(
            runtime_root(
                args.state_dir,
                environment_name="XDG_STATE_HOME",
                fallback=home / ".local/state/dotfiles/chezmoi",
                label="chezmoi operator state directory",
            ),
            label="chezmoi operator state directory",
        )
        cache_root = ensure_private_directory(
            runtime_root(
                args.cache_dir,
                environment_name="XDG_CACHE_HOME",
                fallback=home / ".cache/dotfiles/chezmoi",
                label="chezmoi operator cache directory",
            ),
            label="chezmoi operator cache directory",
        )
        with operator_lock(state_root), recoverable_termination_signals(
            retain_committed_handlers=True
        ) as termination:
            for source in sources:
                ensure_private_directory(
                    cache_root / source.label,
                    label=f"{source.label} chezmoi cache directory",
                )
            executable = resolve_executable(args.chezmoi, label="chezmoi")
            if args.operation == "link":
                just = resolve_executable(args.just, label="just")
                public = sources[0].root
                private = lexical_absolute(args.private_dir)
                parity_check = lexical_absolute(
                    args.parity_check
                    if args.parity_check is not None
                    else public / "tests/check-chezmoi-targets"
                )
                link_current_state(
                    executable=executable,
                    sources=sources,
                    public=public,
                    private=private,
                    home=home,
                    cache_root=cache_root,
                    state_root=state_root,
                    just=just,
                    parity_check=parity_check,
                    termination=termination,
                )
            else:
                run_operation(
                    args.operation,
                    executable=executable,
                    sources=sources,
                    home=home,
                    cache_root=cache_root,
                    state_root=state_root,
                )
    except CutoverError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except TerminationRequested as exc:
        name = signal.Signals(exc.signum).name
        print(f"ERROR: received {name}", file=sys.stderr)
        return 128 + exc.signum
    except KeyboardInterrupt:
        print("ERROR: chezmoi operator command interrupted before completion", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
