#!/usr/bin/env sh
# Cross-platform wrapper for 1Password SSH signing
case "$(uname -s)" in
    Darwin)
        exec /Applications/1Password.app/Contents/MacOS/op-ssh-sign "$@"
        ;;
    Linux)
        platform=${PLATFORM:-}
        if [ -z "$platform" ]; then
            platform=linux
            grep -qiE 'microsoft|wsl' /proc/version /proc/sys/kernel/osrelease 2>/dev/null && platform=wsl
        fi
        if [ "$platform" = "linux" ]; then
            if [ -x /opt/1Password/op-ssh-sign ]; then
                exec /opt/1Password/op-ssh-sign "$@"
            fi
            echo "native 1Password op-ssh-sign not found" >&2
            exit 1
        fi
        for f in "/mnt/c/Program Files/WindowsApps"/Agilebits.1Password_*/op-ssh-sign-wsl; do
            [ -x "$f" ] && exec "$f" "$@"
        done
        # The Store package directory is often unreadable from WSL; the current
        # user's app execution alias and the direct installer's copy are not.
        localappdata=$(/mnt/c/Windows/System32/cmd.exe /d /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')
        localappdata=$(wslpath -u "$localappdata" 2>/dev/null) || localappdata=
        if [ -n "$localappdata" ]; then
            for f in "$localappdata/Microsoft/WindowsApps/op-ssh-sign-wsl.exe" \
                "$localappdata"/1Password/app/*/op-ssh-sign-wsl.exe; do
                [ -x "$f" ] && exec "$f" "$@"
            done
        fi
        echo "op-ssh-sign-wsl not found" >&2
        exit 1
        ;;
esac
